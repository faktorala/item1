# ==========================================
# 1. Keil MDK-ARM 编译输出与用户配置
# ==========================================
# 编译产物
*.o
*.obj
*.axf
*.elf
*.hex
*.bin
*.map
*.lst
*.crf
*.d
*.dep
*.lnp
*.htm
*.build_log.htm
*.bak
*.ddk

# Keil 自动生成的输出文件夹
Objects/
Listings/
DebugConfig/
RTE/

# Keil 用户专属配置（非常重要：保留工程文件 .uvprojx，忽略个人配置）
*.uvoptx
*.uvopt
*.uvguix.*
*.uvgui.*
*.scvd
# 注意：! 代表不忽略（保留），工程文件必须上传，别人下载下来才能打开工程
!*.uvprojx

# ==========================================
# 2. STM32CubeMX 相关文件
# ==========================================
# 保留 .ioc 文件，但忽略它的备份和临时文件
*.ioc.bak
*.mxproject
.mxproject
*.bak

# ==========================================
# 3. VS Code / CLion / 其他 IDE 配置
# ==========================================
.vscode/
.idea/
*.code-workspace
.cache/
.clangd/
compile_commands.json

# ==========================================
# 4. 操作系统生成的文件
# ==========================================
# macOS
.DS_Store
# Windows
Thumbs.db
desktop.ini

# ==========================================
# 5. 其他临时文件与日志
# ==========================================
*.log
*.tmp
*.swp
*~